rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules.
// Without it your database is either wide open or fully locked.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only read and write their own profile and their own contacts
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Alerts can be created by any logged-in user,
    // but only edited by the person who raised them
    match /alerts/{alertId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                    && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
